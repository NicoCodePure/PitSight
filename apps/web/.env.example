# Optional explicit backend base URL override.
# Leave unset when the frontend and backend are on the same host and the backend listens on port 8000.
# Example Pi/LAN override:
# VITE_API_BASE_URL=http://192.168.3.104:8000

# Backend port used by the frontend when VITE_API_BASE_URL is not set.
VITE_API_PORT=8000
