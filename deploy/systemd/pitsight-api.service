[Unit]
Description=PitSight API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__PITSIGHT_SERVICE_USER__
Group=__PITSIGHT_SERVICE_USER__
WorkingDirectory=__PITSIGHT_INSTALL_DIR__/apps/api
EnvironmentFile=/etc/pitsight/pitsight.env
ExecStart=__PITSIGHT_INSTALL_DIR__/apps/api/.venv/bin/python -m uvicorn pitsight_api.main:app --host ${PITSIGHT_API_HOST} --port ${PITSIGHT_API_PORT}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
